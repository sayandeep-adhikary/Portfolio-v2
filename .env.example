# Public base URL of the deployed site (used for metadata, canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS (optional). When unset, the site renders from local fallback content.
# Provide a project ID to source content from Sanity instead.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Shared secret for the Sanity revalidation webhook (POST /api/revalidate).
SANITY_REVALIDATE_SECRET=

# Viewer token for Studio preview / Draft Mode (Presentation). Optional.
SANITY_API_READ_TOKEN=

# Editor token, used ONLY by `npm run seed` to import local content. Optional.
SANITY_API_WRITE_TOKEN=

# Server-only GitHub token (no scopes needed) to enable the Engineering Footprint
# contribution heatmap via the GitHub GraphQL API. Optional; never exposed to the browser.
GITHUB_TOKEN=
